+#[test]
+fn forwarded_connections_share_bounded_flow_limit_and_close_excess() {
+    let (mut nat, mut host) = forwarded_nat(8077);
+    let mut peers = Vec::new();
+    for port in 0..MAX_FLOWS {
+        let (socket, peer) = socket_pair();
+        peers.push(peer);
+        let mut existing = flow();
+        existing.guest_port = 30000 + port as u16;
+        existing.transport = Transport::Connected(socket);
+        nat.tcp.push(existing);
+    }
+    nat.poll(0);
+    assert_eq!(nat.tcp.len(), MAX_FLOWS);
+    assert_eq!(nat.tcp_refused, 1);
+    let mut byte = [0];
+    assert_eq!(host.read(&mut byte).unwrap(), 0);
+    for _ in 1..MAX_FORWARDS {
+        nat.add_forward(&HostForward { bind: SocketAddrV4::new(Ipv4Addr::LOCALHOST, 0), guest_port: 522 }).unwrap();
+    }
+    assert!(nat.add_forward(&HostForward { bind: SocketAddrV4::new(Ipv4Addr::LOCALHOST, 0), guest_port: 522 }).is_err());
+}
