+fn forwarded_nat(port: u16) -> (Nat, TcpStream) {
+    let mut nat = Nat::new(false);
+    let addr = nat.add_forward(&HostForward {
+        bind: SocketAddrV4::new(Ipv4Addr::LOCALHOST, 0), guest_port: port,
+    }).unwrap();
+    nat.observe_guest([2; 6], [10, 0, 2, 15], [10, 0, 2, 2]);
+    let host = TcpStream::connect(addr).unwrap();
+    host.set_read_timeout(Some(std::time::Duration::from_secs(1))).unwrap();
+    (nat, host)
+}
+
+fn forwarded_reply(syn: &[u8], seq: u32, ack: u32, flags: u8, data: &[u8]) -> Vec<u8> {
+    let mut seg = segment(seq, ack, flags, data);
+    seg[..2].copy_from_slice(&syn[36..38]);
+    seg[2..4].copy_from_slice(&syn[34..36]);
+    seg
+}
+
+fn from_guest(nat: &mut Nat, seg: &[u8], now: u64) -> Vec<Vec<u8>> {
+    nat.tcp_in(&[2; 6], &[10, 0, 2, 15], &[10, 0, 2, 2], seg, now)
+}
