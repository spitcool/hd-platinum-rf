+#[test]
+fn forward_specs_reject_nonloopback_and_invalid_ports() {
+    assert_eq!("18078:8077".parse::<HostForward>().unwrap(),
+        "127.0.0.1:18078:8077".parse::<HostForward>().unwrap());
+    for spec in ["0.0.0.0:18078:8077", "192.168.1.1:18078:8077", "localhost:18078:8077",
+                 "18078:0", "0:8077", "65536:8077", "18078:65536", "8077", "::1:18078:8077"] {
+        assert!(spec.parse::<HostForward>().is_err(), "accepted {spec}");
+    }
+    let mut nat = Nat::new(false);
+    assert!(nat.add_forward(&HostForward { bind: SocketAddrV4::new(Ipv4Addr::UNSPECIFIED, 18078), guest_port: 8077 }).is_err());
+}
