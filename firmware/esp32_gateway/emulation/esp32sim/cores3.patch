+#[test]
+fn cores3_three_wire_receive_uses_the_shared_mosi_pad() {
+    let mut m = esp32s3::machine([0; 6]);
+    let state = Arc::new(Mutex::new(State::default()));
+    m.bus.board = Box::new(Board(state.clone()));
+    let bus = &mut m.bus;
+    for (pin, signal) in [(36u32, 101u32), (37, 103), (3, 256)] {
+        bus.write32(0x6000_9004 + 4 * pin, (1 << 12) | (1 << 9)).unwrap();
+        bus.write32(0x6000_4554 + 4 * pin, signal).unwrap();
+    }
+    bus.write32(0x6000_9004 + 4 * 35, (1 << 12) | (1 << 9)).unwrap();
+    bus.write32(0x6000_4154 + 4 * 102, 0x80 | 35).unwrap();
+    bus.write32(0x6000_4024, 1 << 3).unwrap();
+    bus.write32(0x6002_4020, 0x3f).unwrap();
+    for (sio, expected_miso) in [(true, 37u8), (false, 35u8)] {
+        // IDF 4.4 ESP32-S3 spi_reg.h: USER.SIO bit17; USER.USR_MISO bit28.
+        bus.write32(0x6002_4010, (1 << 28) | if sio { 1 << 17 } else { 0 }).unwrap();
+        bus.write32(0x6002_401c, 31).unwrap();
+        bus.write32(0x6002_4000, 1 << 24).unwrap();
+        bus.read32(0x6002_4098).unwrap();
+        let pins = state.lock().unwrap().routes.last().copied().unwrap();
+        assert_eq!(pins.sclk, 1 << 36);
+        assert_eq!(pins.mosi, 0); // A read has no active MOSI output phase.
+        assert_eq!(pins.miso, Some(expected_miso));
+        assert_ne!(pins.cs & (1 << 3), 0);
+    }
