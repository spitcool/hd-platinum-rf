+#[test]
+fn virtual_network_learns_station_before_starting_forwarded_connections() {
+    let (mut nat, _host) = forwarded_nat(8077);
+    nat.guest = None;
+    let mut net = crate::net::VirtualNet::new(false);
+    net.nat = Some(nat);
+    assert!(net.poll(0).is_empty());
+    let packet = ethernet(&GATEWAY_MAC, &[2; 6], 0x0800,
+        &ip_packet(1, &[10, 0, 2, 15], &[10, 0, 2, 2], &[0; 8]));
+    net.handle(&packet, 1);
+    assert!(net.nat.as_ref().unwrap().guest.is_some());
+    let syn = poll_ready(net.nat.as_mut().unwrap(), 2);
+    assert_eq!(syn.len(), 1);
+    assert_eq!(syn[0][47], SYN);
+    assert_eq!(&syn[0][..6], &[2; 6]);
+}
