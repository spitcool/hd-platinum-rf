+#[test]
+fn forwarded_refusal_and_handshake_timeout_release_host_sockets() {
+    for reset in [false, true] {
+        let (mut nat, mut host) = forwarded_nat(522);
+        let syn = poll_ready(&mut nat, 0).remove(0);
+        let isn = u32::from_be_bytes(syn[38..42].try_into().unwrap());
+        if reset {
+            from_guest(&mut nat, &forwarded_reply(&syn, 0, isn, RST | ACK, &[]), 1);
+            assert!(!nat.tcp[0].closed()); // a reset must acknowledge the SYN
+            from_guest(&mut nat, &forwarded_reply(&syn, 0, isn + 1, RST | ACK, &[]), 2);
+            nat.poll(3);
+        } else { nat.poll(INBOUND_HANDSHAKE_US); }
+        assert!(nat.tcp.is_empty());
+        assert_eq!(nat.tcp_refused, 1);
+        let mut byte = [0];
+        assert_eq!(host.read(&mut byte).unwrap(), 0);
+    }
+}
