+#[test]
+fn forwarded_syn_handshake_payload_and_half_close_use_the_guest_stack() {
+    let (mut nat, mut host) = forwarded_nat(8077);
+    host.write_all(b"request").unwrap();
+    let frames = poll_ready(&mut nat, 0);
+    assert_eq!(frames.len(), 1); // queued host bytes cannot bypass the guest handshake
+    let syn = &frames[0];
+    assert_eq!(syn[47], SYN);
+    assert_eq!(&syn[..6], &[2; 6]);
+    assert_eq!(&syn[26..30], &[10, 0, 2, 2]);
+    assert_eq!(&syn[30..34], &[10, 0, 2, 15]);
+    assert_eq!(&syn[36..38], &8077u16.to_be_bytes());
+    assert_eq!(transport_checksum(&[10, 0, 2, 2], &[10, 0, 2, 15], 6, &syn[34..]), 0);
+    let isn = u32::from_be_bytes(syn[38..42].try_into().unwrap());
+    assert_eq!(nat.poll(RETRANSMIT_US), frames); // dropped SYN
+    assert!(from_guest(&mut nat, &forwarded_reply(syn, 9000, isn + 2, SYN | ACK, b"bad"), RETRANSMIT_US + 1).is_empty());
+    assert!(from_guest(&mut nat, &forwarded_reply(syn, 9000, isn + 1, ACK, b"bad"), RETRANSMIT_US + 2).is_empty());
+    assert!(nat.tcp[0].handshake_pending());
+    let reply = forwarded_reply(syn, 9000, isn + 1, SYN | ACK, &[]);
+    let ack = from_guest(&mut nat, &reply, RETRANSMIT_US + 3);
+    assert_eq!(ack.len(), 1);
+    assert_eq!(ack[0][47], ACK);
+    assert_eq!(u32::from_be_bytes(ack[0][42..46].try_into().unwrap()), 9001);
+    assert_eq!(from_guest(&mut nat, &reply, RETRANSMIT_US + 4), ack); // dropped final ACK
+    assert_eq!(nat.tcp_opened, 1);
+    let request = poll_ready(&mut nat, RETRANSMIT_US + 5);
+    assert_eq!(request.len(), 1);
+    assert_eq!(&request[0][54..], b"request");
+    assert_eq!(nat.poll(RETRANSMIT_US * 2 + 5), request); // lost request segment
+    let response = forwarded_reply(syn, 9001, isn + 8, ACK | FIN, b"response");
+    from_guest(&mut nat, &response, RETRANSMIT_US * 2 + 6);
+    from_guest(&mut nat, &response, RETRANSMIT_US * 2 + 7); // duplicate must not duplicate bytes
+    nat.poll(RETRANSMIT_US * 2 + 8);
+    let mut bytes = Vec::new();
+    host.read_to_end(&mut bytes).unwrap();
+    assert_eq!(bytes, b"response");
+    host.shutdown(std::net::Shutdown::Write).unwrap();
+    let fin = poll_ready(&mut nat, RETRANSMIT_US * 2 + 9);
+    assert_eq!(fin.len(), 1);
+    assert_eq!(fin[0][47], FIN | ACK);
+    assert_eq!(nat.poll(RETRANSMIT_US * 3 + 9), fin);
+    from_guest(&mut nat, &forwarded_reply(syn, 9010, isn + 9, ACK, &[]), RETRANSMIT_US * 3 + 10);
+    nat.poll(RETRANSMIT_US * 3 + 11);
+    assert!(matches!(nat.tcp[0].transport, Transport::TimeWait));
+    nat.poll(RETRANSMIT_US * 3 + 11 + TIME_WAIT_US);
+    assert!(nat.tcp.is_empty());
+}
