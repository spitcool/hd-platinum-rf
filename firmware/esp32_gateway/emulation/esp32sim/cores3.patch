+#[test]
+fn established_forwarded_reset_and_idle_expiry_release_sockets() {
+    for reset in [false, true] {
+        let (mut nat, mut host) = forwarded_nat(522);
+        let syn = poll_ready(&mut nat, 0).remove(0);
+        let isn = u32::from_be_bytes(syn[38..42].try_into().unwrap());
+        from_guest(&mut nat, &forwarded_reply(&syn, 2000, isn + 1, SYN | ACK, &[]), 1);
+        if reset {
+            from_guest(&mut nat, &forwarded_reply(&syn, 2001, isn + 1, RST | ACK, &[]), 2);
+            nat.poll(3);
+        } else { nat.poll(IDLE_CLOSE_US + 1); }
+        assert!(nat.tcp.is_empty());
+        let mut byte = [0];
+        assert_eq!(host.read(&mut byte).unwrap(), 0);
+    }
+}
