+#[test]
+fn forwarded_source_ports_do_not_alias_outbound_tuples() {
+    let (mut nat, _host) = forwarded_nat(8077);
+    let (socket, _outbound_host) = socket_pair();
+    let mut existing = flow();
+    existing.guest_port = 8077;
+    existing.dst_ip = [10, 0, 2, 2];
+    existing.dst_port = FIRST_FORWARD_PORT;
+    existing.transport = Transport::Connected(socket);
+    nat.tcp.push(existing);
+    let syn = poll_ready(&mut nat, 0).remove(0);
+    assert_eq!(u16::from_be_bytes(syn[34..36].try_into().unwrap()), FIRST_FORWARD_PORT + 1);
+    assert_eq!(nat.tcp.len(), 2);
+    let isn = u32::from_be_bytes(syn[38..42].try_into().unwrap());
+    from_guest(&mut nat, &forwarded_reply(&syn, 1000, isn + 1, SYN | ACK, &[]), 1);
+    assert_eq!(nat.tcp[0].guest_seq, 200);
+    assert_eq!(nat.tcp[1].guest_seq, 1001);
+}
