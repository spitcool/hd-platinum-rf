index 92af6a5..89decb2 100644
--- a/cli/src/tests.rs
+++ b/cli/src/tests.rs
@@ -1,5 +1,23 @@
 use super::*;
 
+#[test]
+fn host_forwarding_parses_repeated_rules_and_requires_a_nat_access_point() {
+    let args: Vec<String> = ["esp32sim", "--wifi", "ssid=Wokwi-GUEST", "--net", "user",
+        "--hostfwd", "127.0.0.1:18080:8077", "--hostfwd", "1523:522"].into_iter().map(str::to_string).collect();
+    let mut options = parse(&args, "s3");
+    assert_eq!(options.hostfwd.len(), 2);
+    assert_eq!(options.hostfwd[0].bind.port(), 18080);
+    assert_eq!(options.hostfwd[0].guest_port, 8077);
+    assert_eq!(options.hostfwd[1].guest_port, 522);
+    options.net = "none".into();
+    assert!(validate_forwarding(&options).is_err());
+    options.net = "nat".into();
+    options.wifi = None;
+    assert!(validate_forwarding(&options).is_err());
+    options.hostfwd.clear();
+    assert!(validate_forwarding(&options).is_ok());
+}
