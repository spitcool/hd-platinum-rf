    },
    "G11": {
      "x": 3,
      "y": 61,
      "target": [
        "GPIO11",
        "touch1:SCL"
      ]
    },
    "G12": {
      "x": 3,
      "y": 66,
      "target": [
        "GPIO12",
        "touch1:SDA"
      ]
    },
    "G13": {
      "x": 3,
      "y": 71,
      "target": "GPIO13"
    },
    "G14": {
      "x": 3,
      "y": 76,
      "target": "GPIO14"
    },
    "G17": {
      "x": 3,
      "y": 81,
      "target": "GPIO17"
    },
    "G18": {
      "x": 117,
