        "GPIO35",
        "lcd1:D/C"
      ]
    },
    "G36": {
      "x": 117,
      "y": 21,
      "target": [
        "GPIO36",
        "lcd1:SCK"
      ]
    },
    "G37": {
      "x": 117,
      "y": 26,
      "target": [
        "GPIO37",
        "lcd1:MOSI",
        "lcd1:MISO"
