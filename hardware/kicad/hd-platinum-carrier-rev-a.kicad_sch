(text "HD PLATINUM 2.4 GHz RADIO CARRIER" (at 15.24 15.24 0) (effects (font (size 2.54 2.54)) (justify left top)) (uuid 829dfa7a-a27d-5e54-a944-d5bdf85c503a))
(text "REV A  |  ENGINEERING FIRST ARTICLE - NOT PRODUCTION RELEASED" (at 15.24 21.59 0) (effects (font (size 1.524 1.524)) (justify left top)) (uuid 4d5652fd-75b1-5a29-b6b3-43507fc8b701))
(text "CoreS3-SE K128-SE + M032 frame + Base LAN v1.2 K012-B-V12" (at 15.24 27.94 0) (effects (font (size 1.27 1.27)) (justify left top)) (uuid aadcdb83-de2e-51be-b09d-987f62fafe32))
(text "HOST / STACK-THROUGH BUS" (at 15.24 39.37 0) (effects (font (size 1.524 1.524)) (justify left top)) (uuid c1de8c07-8fe7-5918-b383-0d1f0ce58c1e))
(text "DEDICATED 3.3 V RADIO SUPPLY" (at 127 39.37 0) (effects (font (size 1.524 1.524)) (justify left top)) (uuid f66d88ab-6b36-5036-a77e-c8c09160fce7))
(text "C1/C2 at U2 IN; C3 at U2 OUT.\nU2 EN follows host rail; RF_3V3 is NOT tied to HOST_3V3.\nAll MLCC values are nominal: account for DC-bias derating." (at 307.34 55.88 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid 95d0f023-63d7-536f-bf0a-bc38a8264d05))
(text "Power flags identify external supply rails / continuity through FB1." (at 127 115.57 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid 431a85d9-5913-5c53-9ef6-7646ece8bbe8))
(text "DEDICATED RADIO SPI / DEFAULT STATES" (at 127 134.62 0) (effects (font (size 1.524 1.524)) (justify left top)) (uuid 532507bd-2240-5af2-a6c7-42228b1c9ea9))
(text "C4/C5 at U1 VCC/GND" (at 340.36 111.76 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid 4c32a539-5b69-5b92-aece-fe6ce6f1d692))
(text "50 ohm controlled trace.\nNo RF test-pad stubs.\nU.FL to external antenna.\nANT is pin 11, never pin 9." (at 342.9 182.88 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid 5014fb91-db7f-54af-9200-95e71ad350fd))
(text "NiceRF current V3.1 numbering\nRF_PWR <= 2; default RF_PWR = 0.\nDo not substitute RF2401PRO or Si24R1." (at 281.94 247.65 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid 4745432f-7c9f-54c4-a326-8ce4baf6d503))
(text "R1-R4 near host connector; R5 near radio.\nCE low, CSN high only after RF_3V3 is stable.\nInitial SPI: mode 0, 1 MHz. Reserve Ports B/C." (at 127 152.4 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid 09216898-9f70-5468-87ca-cca23d19bc01))
(text "Unused contacts marked X have NO carrier tap.\nTheir top/bottom stack-through connection remains.\nDo not ground HPWR contacts 25/27/29.\n\nEthernet: MOSI37/MISO35/SCK36/CS9/RST7/IRQ14.\nGPIO35 is also LCD D/C: firmware must arbitrate.\nDisable SD and audio for initial qualification." (at 15.24 147.32 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid 827033c0-94b1-5e68-88f5-61f4191bfe3a))
(text "TEST POINTS - no assembled components" (at 15.24 238.76 0) (effects (font (size 1.524 1.524)) (justify left top)) (uuid 1f044309-9536-519f-a7e8-3e196663b086))
(text "Source: hardware/design/board-spec.json\nSee electrical-evidence.md and manufacturing acceptance documents.\nCurrent carrier / packet-radio combination requires first-article validation." (at 15.24 271.78 0) (effects (font (size 1.016 1.016)) (justify left top)) (uuid ae72330d-3205-5f39-8e6d-371e21517785))
